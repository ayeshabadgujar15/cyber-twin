GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
# Optional: sends your connected Gmail address to HIBP only when you click Check.
HIBP_API_KEY=
# Optional legacy enrichment APIs
INTELBASE_API_KEY=
GRAVATAR_API_KEY=

# Import a Desktop app JSON in Help & setup for automatic local ports.
GOOGLE_CLIENT_TYPE=web
